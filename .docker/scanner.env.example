# eSCL address of the scanner, reachable from the fastapi container
SCANNER_URL="https://192.168.1.15"
# The printer certificate, pinned. Fetch it once with:
# openssl s_client -connect 192.168.1.15:443 </dev/null | openssl x509 > backend/certs/scanner.pem
SCANNER_CA_CERT="/backend/certs/scanner.pem"
